{
  "name": "walktracker",
  "version": "1.0.0",
  "private": true,
  "description": "Walk every block of your city. A self-hosted, private alternative to WalkNYC.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "test:properties": "PROPERTY_CASES=1000 node --test tests/properties.test.mjs",
    "test:sim": "node --test tests/sim/nyc.test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
